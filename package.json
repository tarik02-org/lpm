{
  "name": "@tarik02/lpm",
  "version": "0.0.0",
  "description": "Link local package roots into consumer projects",
  "keywords": [
    "cli",
    "developer-tools",
    "local-packages",
    "package-manager"
  ],
  "homepage": "https://github.com/tarik02-org/lpm#readme",
  "bugs": {
    "url": "https://github.com/tarik02-org/lpm/issues"
  },
  "license": "MIT",
  "author": "tarik02 <taras.fomin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarik02-org/lpm.git"
  },
  "bin": {
    "lpm": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "changeset": "changeset",
    "check": "vp check && tsgo --noEmit",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "prepack": "pnpm build",
    "release:check": "pnpm check && pnpm pack --dry-run",
    "release:publish": "changeset publish",
    "release:version": "changeset version && pnpm format",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@effect/platform-node": "4.0.0-rc.110",
    "@npmcli/arborist": "^10.0.2",
    "effect": "4.0.0-rc.110",
    "jsonc-parser": "^3.3.1",
    "npm-packlist": "^11.3.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/language-service": "0.84.2",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vite-plus": "^0.2.9"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.2"
}
